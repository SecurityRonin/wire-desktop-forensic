{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    }
  ],
  "minimumReleaseAge": "21 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "prPriority": 10
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on the first day of the month"
    ]
  }
}
